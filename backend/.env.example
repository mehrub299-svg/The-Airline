# ---- App ----
APP_ENV=development
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- Database (Neon). Paste the Neon string as-is; sslmode/channel_binding are converted automatically ----
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# ---- Auth ----
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- OpenRouter ----
OPENROUTER_API_KEY=sk-or-v1-your-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_CHAT_MODEL=openai/gpt-4o-mini
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small

# ---- Billing: sandbox_no_bank = no Stripe account needed. Swap in sk_test_... / sk_live_... for a client ----
STRIPE_SECRET_KEY=sandbox_no_bank
STRIPE_WEBHOOK_SECRET=whsec_sandbox_local_secret
STRIPE_PRO_PRICE_ID=

# ---- Optional non-blocking n8n webhook (leave empty to disable) ----
N8N_WEBHOOK_URL=